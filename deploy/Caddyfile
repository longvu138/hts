{
	admin off
	email {$ACME_EMAIL}
}

{$HTS_SITE_ADDRESS::80} {
	encode zstd gzip
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:3108
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Internal readiness probe; this port is not published on the VPS.
:8080 {
	respond /healthz "ok" 200
}
