# deploy.sh tạo cấu hình riêng ngoài source với secret ngẫu nhiên; không dùng nguyên giá trị mẫu này.
COMPOSE_PROJECT_NAME=hts
# Script điền tên image khi bạn chạy deploy <dockerhub> <phiên-bản>.
HTS_BACKEND_IMAGE=
HTS_WEB_IMAGE=
# Để trống: HTTP cổng 80, không cần khai báo IP/tên miền.
PUBLIC_ORIGIN=
# Tương thích cấu hình cũ; không cần nhập cho lần cài mới.
HTS_DOMAIN=
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
HTS_DATA_DIR=/srv/hts-data
MYSQL_DATABASE=hts
MYSQL_USER=hts
MYSQL_PASSWORD=GENERATE_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_ROOT_DB_PASSWORD
JWT_SECRET=GENERATE_JWT_SECRET
CSRF_SECRET=GENERATE_CSRF_SECRET
# Để trống thì chỉ có thông báo trong ứng dụng, không gửi Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
