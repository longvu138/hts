# Môi trường chạy production; dùng để bật hành vi bảo mật và logging phù hợp.
NODE_ENV=production
# Cổng HTTP nội bộ backend lắng nghe.
PORT=3108

# Địa chỉ, cổng, tài khoản, mật khẩu và tên database MySQL production.
DB_HOST=<DB_HOST>
DB_PORT=3306
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>
# Pool nhỏ để tránh vượt giới hạn kết nối trên shared hosting.
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=30000

# Mức log tối thiểu; kích thước tối đa mỗi file log; thời gian giữ log.
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_RETENTION=30d

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên; backend từ chối khởi động với giá trị mẫu.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=hts-backend
JWT_AUDIENCE=hts-web
# Khóa riêng để ký CSRF token; tối thiểu 32 ký tự và phải khác JWT_SECRET.
CSRF_SECRET=replace-with-a-separate-random-secret
# Chỉ đặt tạm khi cần tạo quản trị viên đầu tiên qua API (header X-Bootstrap-Token); xóa sau khi dùng.
BOOTSTRAP_TOKEN=
# Tiền tố __Host- buộc cookie Secure, Path=/ và không khai báo Domain.
AUTH_COOKIE_NAME=__Host-hts_session
# Production bắt buộc true để cookie chỉ truyền qua HTTPS.
AUTH_COOKIE_SECURE=true
# lax phù hợp khi frontend/backend cùng site; dùng none nếu khác site hoàn toàn và vẫn giữ Secure=true.
AUTH_COOKIE_SAME_SITE=lax
# Origin frontend chính xác được phép gọi API; nhiều origin phân tách bằng dấu phẩy, không dùng *.
CORS_ALLOWED_ORIGINS=https://frontend.example.gov.vn
# Tin đúng một reverse proxy phía trước (ví dụ một lớp Nginx) để lấy đúng IP và giao thức HTTPS.
TRUST_PROXY=1

# Kích thước tối đa của JSON/form body và số tham số form tối đa.
REQUEST_BODY_LIMIT=1mb
REQUEST_PARAMETER_LIMIT=100
# Rate limit toàn API: 900000 ms = 15 phút, tối đa 600 request/IP.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
# Rate limit login: cửa sổ 15 phút, tối đa 10 lần sai theo IP + username.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Rate limit đăng nhập sai theo riêng IP.
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=50
# Rate limit thao tác xác thực nhạy cảm như đổi/reset mật khẩu và thu hồi toàn bộ phiên.
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10
# Tối đa 10 phiên hoạt động cho mỗi tài khoản; phiên cũ hơn tự động bị thu hồi khi có phiên mới.
MAX_ACTIVE_SESSIONS_PER_USER=10
# Thời gian chờ graceful shutdown trước khi tiến trình bị buộc dừng.
SHUTDOWN_TIMEOUT_MS=10000

# Web Push: tạo cặp khóa VAPID riêng cho production; để trống thì tắt Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
