# Môi trường chạy: development, test hoặc production.
NODE_ENV=development
# Cổng HTTP backend lắng nghe.
PORT=3108

# Địa chỉ, cổng, tài khoản, mật khẩu và tên database MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hts
# Pool nhỏ để phù hợp shared hosting; DB_POOL_MAX luôn được giới hạn không vượt quá 4.
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=30000

# Mức log tối thiểu; kích thước tối đa mỗi file log; thời gian giữ log.
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_RETENTION=30d

# Khóa ký JWT, thời hạn phiên, đơn vị phát hành và đối tượng sử dụng token.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production từ chối khởi động nếu khóa thiếu, ngắn hơn 32 ký tự, là giá trị mẫu hoặc trùng CSRF_SECRET.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=hts-backend
JWT_AUDIENCE=hts-web
# Khóa riêng để ký CSRF token, phải khác JWT_SECRET. Local thiếu biến này thì backend tự dẫn xuất
# một khóa riêng từ JWT_SECRET kèm cảnh báo; production bắt buộc cấu hình.
CSRF_SECRET=replace-with-a-separate-random-secret
# Mã dùng một lần cho POST /api/auth/bootstrap-admin (header X-Bootstrap-Token), tối thiểu 32 ký tự.
# Để trống thì API bootstrap tắt; xóa giá trị sau khi đã tạo quản trị viên đầu tiên.
BOOTSTRAP_TOKEN=
# Tên cookie chứa JWT. Local không dùng tiền tố __Host- vì chưa chạy HTTPS.
AUTH_COOKIE_NAME=hts_session
# true chỉ gửi cookie qua HTTPS; local HTTP đặt false, production bắt buộc true.
AUTH_COOKIE_SECURE=false
# Chính sách gửi cookie chéo website: strict, lax hoặc none. none bắt buộc Secure=true.
AUTH_COOKIE_SAME_SITE=lax
# Danh sách origin frontend được gọi API, phân tách bằng dấu phẩy; không dùng dấu * khi gửi cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3109,http://localhost:4174
# Số lớp reverse proxy đáng tin trước Node.js; để trống khi chạy trực tiếp, thường là 1 khi qua một Nginx.
TRUST_PROXY=

# Kích thước tối đa của JSON/form body và số tham số form tối đa trong một request.
REQUEST_BODY_LIMIT=1mb
REQUEST_PARAMETER_LIMIT=100
# Rate limit toàn API: cửa sổ thời gian (ms) và số request tối đa theo IP trong cửa sổ đó.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
# Rate limit đăng nhập: cửa sổ thời gian (ms) và số lần sai tối đa theo IP + username.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Rate limit đăng nhập sai theo riêng IP (mọi username).
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=50
# Rate limit cho đổi/reset mật khẩu và thao tác xác thực nhạy cảm.
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10
# Số phiên đăng nhập còn hiệu lực tối đa cho mỗi tài khoản; phiên cũ hơn tự động bị thu hồi.
MAX_ACTIVE_SESSIONS_PER_USER=10
# Thời gian tối đa chờ đóng kết nối khi backend shutdown trước khi buộc thoát.
SHUTDOWN_TIMEOUT_MS=10000

# Cặp khóa Web Push VAPID và thông tin liên hệ chủ thể (mailto: hoặc URL HTTPS).
# Tạo cặp khóa riêng: node -e 'console.log(require("web-push").generateVAPIDKeys())'. Để trống thì tắt Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
