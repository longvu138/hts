# GIAO VIỆC: chỉ dùng dữ liệu E2E, không sửa/xóa dữ liệu thật.
# Đăng nhập theo auth.curl, tạo session.cookies.txt và lấy <CSRF_TOKEN>.
# Thay <STAFF_ID>, <WORK_ID>, <PART_ID> bằng UUID trả về từ API.
# Cập nhật version bằng phiên bản mới nhất mỗi lần thao tác; phiên bản cũ trả 409.
# no-permission.cookies.txt là phiên của user ngoài phạm vi/không có quyền.
# Thời gian ví dụ cần đổi sang ngày bạn muốn kiểm tra; +07:00 là giờ Việt Nam.
# Xác thực bằng cookie phiên HttpOnly.

# [1.1 Thành công tối giản 200/201] Danh sách cá nhân
curl --location --request GET 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt

# [1.2 Thành công đầy đủ] Dùng dữ liệu mới/phiên bản mới nếu kịch bản trước đã thay đổi dữ liệu.
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=mine&from=2026-11-01T00%3A00%3A00%2B07%3A00&to=2026-11-07T23%3A59%3A59%2B07%3A00&page=1&limit=20&status=assigned&q=E2E' \
  --cookie session.cookies.txt

# [1.3 Validation 422]
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=sai' \
  --cookie session.cookies.txt

# [1.4 Bảo mật 401] Thiếu phiên hoặc thay cookie bằng cookie hết hạn.
curl --location --request GET 'http://localhost:3108/api/work-assignments'
# Danh sách cá nhân cho mọi user đã đăng nhập; chỉ trả dữ liệu của chính mình.

# [2.1 Thành công tối giản 200/201] Danh sách người nhận: work.assign
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients' \
  --cookie session.cookies.txt

# [2.2 Thành công đầy đủ] Dùng dữ liệu mới/phiên bản mới nếu kịch bản trước đã thay đổi dữ liệu.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?q=E2E&page=1&limit=50' \
  --cookie session.cookies.txt

# [2.3 Validation 422]
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?limit=1000' \
  --cookie session.cookies.txt

# [2.4 Bảo mật 401] Thiếu phiên hoặc thay cookie bằng cookie hết hạn.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients'

# [2.5 Bảo mật 403] Không đủ quyền, ngoài phạm vi hoặc không phải người được thao tác.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients' \
  --cookie no-permission.cookies.txt

# [3.1 Thành công tối giản 200/201] Chi tiết nhánh được phép xem
curl --location --request GET 'http://localhost:3108/api/work-assignments/<WORK_ID>' \
  --cookie session.cookies.txt

# [3.2 Thành công đầy đủ] Dùng dữ liệu mới/phiên bản mới nếu kịch bản trước đã thay đổi dữ liệu.
curl --location --request GET 'http://localhost:3108/api/work-assignments/<WORK_ID>?page=1&limit=20&historyPage=1' \
  --cookie session.cookies.txt

# [3.3 Validation 422]
curl --location --request GET 'http://localhost:3108/api/work-assignments/sai-id' \
  --cookie session.cookies.txt

# [3.4 Bảo mật 401] Thiếu phiên hoặc thay cookie bằng cookie hết hạn.
curl --location --request GET 'http://localhost:3108/api/work-assignments/<WORK_ID>'

# [3.5 Bảo mật 403] Không đủ quyền, ngoài phạm vi hoặc không phải người được thao tác.
curl --location --request GET 'http://localhost:3108/api/work-assignments/<WORK_ID>' \
  --cookie no-permission.cookies.txt

# [4.1 Thành công tối giản 200/201] Tạo việc: work.assign hoặc work.self_create
curl --location --request POST 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt \
  --header 'Content-Type: application/json' \
  --header 'X-CSRF-Token: <CSRF_TOKEN>' \
  --data-raw '{"title": "E2E Kiểm tra trong ngày", "source": "assigned", "segments": [{"content": "E2E Kiểm tra hồ sơ", "place": "Khu A", "startsAt": "2026-11-01T08:00:00+07:00", "endsAt": "2026-11-01T11:30:00+07:00", "assigneeIds": ["<STAFF_ID>"]}]}'

# [4.2 Thành công đầy đủ] Dùng dữ liệu mới/phiên bản mới nếu kịch bản trước đã thay đổi dữ liệu.
curl --location --request POST 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt \
  --header 'Content-Type: application/json' \
  --header 'X-CSRF-Token: <CSRF_TOKEN>' \
  --data-raw '{"title": "E2E Kiểm tra trong ngày", "source": "assigned", "segments": [{"content": "E2E Kiểm tra hồ sơ", "place": "Khu A", "startsAt": "2026-11-01T08:00:00+07:00", "endsAt": "2026-11-01T11:30:00+07:00", "assigneeIds": ["<STAFF_ID>"]}, {"content": "E2E Buổi chiều", "place": "Khu B", "startsAt": "2026-11-01T13:30:00+07:00", "endsAt": "2026-11-01T17:00:00+07:00", "assigneeIds": ["<OTHER_STAFF_ID>"]}], "description": "E2E Giao nhiều đoạn, khác nhóm"}'

# [4.3 Validation 422]
curl --location --request POST 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt \
  --header 'Content-Type: application/json' \
  --header 'X-CSRF-Token: <CSRF_TOKEN>' \
  --data-raw '{}'

# [4.4 Bảo mật 401] Thiếu phiên hoặc thay cookie bằng cookie hết hạn.
curl --location --request POST 'http://localhost:3108/api/work-assignments' \
  --header 'Content-Type: application/json' \
  --data-raw '{"title": "E2E Kiểm tra trong ngày", "source": "assigned", "segments": [{"content": "E2E Kiểm tra hồ sơ", "place": "Khu A", "startsAt": "2026-11-01T08:00:00+07:00", "endsAt": "2026-11-01T11:30:00+07:00", "assigneeIds": ["<STAFF_ID>"]}]}'

# [4.5 Bảo mật 403] Không đủ quyền, ngoài phạm vi hoặc không phải người được thao tác.
