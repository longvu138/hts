  --header 'Content-Type: application/json' \
  --header 'X-CSRF-Token: <CSRF_TOKEN>' \
  --data-raw '{"title": "E2E Kiểm tra trong ngày", "source": "assigned", "segments": [{"content": "E2E Kiểm tra hồ sơ", "place": "Khu A", "startsAt": "2026-11-01T08:00:00+07:00", "endsAt": "2026-11-01T11:30:00+07:00", "assigneeIds": ["<STAFF_ID>"]}]}'

# [5.1 Thành công tối giản 200/201] Sửa thông tin chung: người tạo
curl --location --request PATCH 'http://localhost:3108/api/work-assignments/<WORK_ID>' \
  --cookie session.cookies.txt \
  --header 'Content-Type: application/json' \
  --header 'X-CSRF-Token: <CSRF_TOKEN>' \
  --data-raw '{"version": 1, "title": "E2E Đổi tên"}'

# [5.2 Thành công đầy đủ] Dùng dữ liệu mới/phiên bản mới nếu kịch bản trước đã thay đổi dữ liệu.
