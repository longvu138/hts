# [409] Gửi lại lịch trùng người/giờ đã lưu, gửi version cũ (WORK_VERSION_CONFLICT), hoặc thao tác phần đã
# hoàn thành/đã chuyển/đã hủy (WORK_STATE_CONFLICT). Cùng một người bị chọn ở hai khung giờ chồng nhau
# trong CÙNG yêu cầu là dữ liệu sai -> 422.
curl --request POST 'http://localhost:3108/api/work-assignments' --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"title":"E2E Trùng trong yêu cầu","source":"assigned","segments":[{"content":"E2E Sáng","place":"Khu A","startsAt":"2026-11-01T08:00:00+07:00","endsAt":"2026-11-01T12:00:00+07:00","assigneeIds":["<STAFF_ID>"]},{"content":"E2E Trưa","place":"Khu A","startsAt":"2026-11-01T11:00:00+07:00","endsAt":"2026-11-01T13:00:00+07:00","assigneeIds":["<STAFF_ID>"]}]}'

# [409 WORK_STATE_CONFLICT] Sửa phần đã chuyển tiếp (người giao trực tiếp, version mới nhất).
curl --request PATCH 'http://localhost:3108/api/work-parts/<TRANSFERRED_PART_ID>' --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"version":<VERSION>,"segments":[{"content":"E2E Sửa","place":"Khu A","startsAt":"2026-11-01T08:00:00+07:00","endsAt":"2026-11-01T09:00:00+07:00","assigneeIds":["<STAFF_ID>"]}]}'

# [Phân trang] page sai về 1, limit kẹp trong 1..100; response có pagination.totalPages.
# [Đồng thời] Chạy test database riêng: E2E_MYSQL_SOCKET=/tmp/mysql-e2e.sock pnpm test:database
# Test bao gồm trùng cùng payload, liền giờ, qua ngày, 3 cấp chuyển, rollback, thu hồi quyền và hai yêu cầu đồng thời.

# [Người thực hiện - thành công] Lọc nhánh đã giao; không mở rộng quyền xem.
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=given&assigneeId=<STAFF_ID>' --cookie session.cookies.txt
# [Người thực hiện - danh mục tối giản và đầy đủ] work.assign hoặc work.schedule_view.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given' --cookie session.cookies.txt
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given&q=E2E&page=1&limit=20' --cookie session.cookies.txt
# [Validation 422]
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=given&assigneeId=sai' --cookie session.cookies.txt
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=sai' --cookie session.cookies.txt
# [Bảo mật 401/403] Không có phiên / không có quyền lọc người.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given'
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given' --cookie no-permission.cookies.txt
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=given&assigneeId=<STAFF_ID>' --cookie no-permission.cookies.txt

# [Khoảng ngày thành công] Từ đầu năm, vẫn phân trang 20 phân công.
curl --location --request GET 'http://localhost:3108/api/work-assignments?from=2026-01-01T00%3A00%3A00%2B07%3A00&to=2026-10-25T00%3A00%3A00%2B07%3A00&page=1&limit=20' --cookie session.cookies.txt
# [Khoảng ngày validation 422] Vượt tối đa 366 ngày.
curl --location --request GET 'http://localhost:3108/api/work-assignments?from=2026-01-01T00%3A00%3A00%2B07%3A00&to=2027-01-03T00%3A00%3A00%2B07%3A00' --cookie session.cookies.txt

# [Tìm tên đã sửa - 200] Tìm theo cả tên phần việc và tên chung, vẫn giới hạn nhánh được xem.
curl --location --request GET 'http://localhost:3108/api/work-assignments?mode=given&q=E2E' --cookie session.cookies.txt

# [Kiểm tra lịch bận - thành công tối giản 200] Chỉ đọc; source=self chỉ cho bản thân.
curl --location --request POST 'http://localhost:3108/api/work-assignments/availability' --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"action":"create","source":"assigned","segments":[{"assigneeIds":["<STAFF_ID>"],"startsAt":"2026-11-01T08:00:00+07:00","endsAt":"2026-11-01T11:30:00+07:00"}]}'
# [Kiểm tra lịch bận - đầy đủ 200] Sửa lịch do mình giao, bỏ qua chính phân công đang sửa.
curl --location --request POST 'http://localhost:3108/api/work-assignments/availability' --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"action":"edit","source":"assigned","excludeAssignmentId":"<PART_ID>","segments":[{"assigneeIds":["<STAFF_ID>"],"startsAt":"2026-11-01T13:30:00+07:00","endsAt":"2026-11-01T17:00:00+07:00"}]}'
# [Validation 422] Thiếu người/giờ.
curl --location --request POST 'http://localhost:3108/api/work-assignments/availability' --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"action":"create","source":"assigned","segments":[]}'
# [Bảo mật 401] Chưa đăng nhập.
curl --location --request POST 'http://localhost:3108/api/work-assignments/availability' --header 'Content-Type: application/json' --data '{}'
# [Bảo mật 403] Không đủ quyền giao cho người được chọn; dùng CSRF của đúng phiên.
curl --location --request POST 'http://localhost:3108/api/work-assignments/availability' --cookie no-permission.cookies.txt --header 'X-CSRF-Token: <NO_PERMISSION_CSRF_TOKEN>' --header 'Content-Type: application/json' --data '{"action":"create","source":"assigned","segments":[{"assigneeIds":["<STAFF_ID>"],"startsAt":"2026-11-01T08:00:00+07:00","endsAt":"2026-11-01T11:30:00+07:00"}]}'
# Nếu chỉ có quyền giao mà không có quyền xem lịch, response chỉ có người và giờ bận;
# title/place/workId/id được lược bỏ. Kiểm tra này không thay thế kiểm tra trong transaction lưu.

# [Khôi phục người được lọc - 200] Tra ID trong đúng danh sách được phép; ID ngoài nhánh trả items rỗng.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given&id=<STAFF_ID>' --cookie session.cookies.txt
# [Validation 422] ID không hợp lệ.
curl --location --request GET 'http://localhost:3108/api/work-assignments/recipients?mode=given&id=sai' --cookie session.cookies.txt

# [Phân quyền]: không có work.assign, kể cả có work.schedule_view -> 403 khi xem việc đã giao.
curl 'http://localhost:3108/api/work-assignments?mode=given' \
  --cookie '<MEMBER_COOKIE>'

# [Phân quyền]: người ngoài phạm vi hoặc có system.manage/phạm vi giao rộng hơn không xuất hiện (200, items rỗng).
curl 'http://localhost:3108/api/work-assignments/recipients?id=<HIGHER_OR_OUTSIDE_STAFF_ID>' \
  --cookie '<MANAGER_COOKIE>'

# [Phân quyền]: cố gửi ID người cao quyền trực tiếp -> 403 WORK_RECIPIENT_FORBIDDEN, không tạo việc.
curl 'http://localhost:3108/api/work-assignments' \
  --header 'Content-Type: application/json' --header 'X-CSRF-Token: <MANAGER_CSRF_TOKEN>' \
  --cookie '<MANAGER_COOKIE>' \
  --data '{"title":"E2E Kiểm tra quyền","source":"assigned","segments":[{"content":"E2E Kiểm tra quyền","place":"Văn phòng","startsAt":"2027-02-01T08:00:00+07:00","endsAt":"2027-02-01T09:00:00+07:00","assigneeIds":["<HIGHER_STAFF_ID>"]}]}'

# Tạo việc bắt đầu trong quá khứ: chưa xác nhận -> 409 WORK_PAST_CONFIRMATION_REQUIRED, chưa ghi dữ liệu.
curl --request POST 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' \
  --data '{"title":"E2E Nhập việc cũ","source":"assigned","segments":[{"content":"E2E Kiểm tra","place":"Khu A","startsAt":"2026-01-03T08:00:00+07:00","endsAt":"2026-01-03T11:30:00+07:00","assigneeIds":["<STAFF_ID>"]}]}'
# Sau khi người dùng xác nhận: cùng dữ liệu + confirmPastStart=true -> 201 nếu đủ quyền và không trùng lịch.
curl --request POST 'http://localhost:3108/api/work-assignments' \
  --cookie session.cookies.txt --header 'X-CSRF-Token: <CSRF_TOKEN>' --header 'Content-Type: application/json' \
  --data '{"title":"E2E Nhập việc cũ","source":"assigned","confirmPastStart":true,"segments":[{"content":"E2E Kiểm tra","place":"Khu A","startsAt":"2026-01-03T08:00:00+07:00","endsAt":"2026-01-03T11:30:00+07:00","assigneeIds":["<STAFF_ID>"]}]}'
# Kiểm tra thêm: confirmPastStart="true" (chuỗi) -> 422; không cookie -> 401;
# tài khoản không có quyền tạo/giao -> 403; xác nhận không bỏ qua kiểm tra trùng lịch (409).

# Việc đã giao nhóm theo người: phân trang theo người, mỗi nhóm trả tối đa 5 việc đầu.
curl --get 'http://localhost:3108/api/work-assignments' --cookie session.cookies.txt \
  --data 'mode=given' --data 'groupBy=assignee' --data 'page=1' --data 'limit=25' \
  --data-urlencode 'from=2026-11-01T00:00:00+07:00' --data-urlencode 'to=2026-11-08T00:00:00+07:00'
# Đầy đủ: nhóm vẫn áp dụng đúng tìm kiếm/trạng thái/người nhận.
curl --get 'http://localhost:3108/api/work-assignments' --cookie session.cookies.txt \
  --data 'mode=given' --data 'groupBy=assignee' --data 'status=assigned' --data-urlencode 'q=Kiểm tra' \
  --data-urlencode 'assigneeId=<STAFF_ID>' --data-urlencode 'from=2026-11-01T00:00:00+07:00' --data-urlencode 'to=2026-11-08T00:00:00+07:00'
# Trang việc thứ 2 của một người: bỏ groupBy, giữ nguyên bộ lọc, limit=5.
curl --get 'http://localhost:3108/api/work-assignments' --cookie session.cookies.txt \
  --data 'mode=given' --data-urlencode 'assigneeId=<STAFF_ID>' --data 'page=2' --data 'limit=5' \
  --data-urlencode 'from=2026-11-01T00:00:00+07:00' --data-urlencode 'to=2026-11-08T00:00:00+07:00'
# Sai kiểu nhóm -> 422; không login -> 401; không có work.assign -> 403.
curl --get 'http://localhost:3108/api/work-assignments' --cookie session.cookies.txt --data 'mode=given' --data 'groupBy=bad'
curl --get 'http://localhost:3108/api/work-assignments' --data 'mode=given' --data 'groupBy=assignee'
curl --get 'http://localhost:3108/api/work-assignments' --cookie member.cookies.txt --data 'mode=given' --data 'groupBy=assignee'
